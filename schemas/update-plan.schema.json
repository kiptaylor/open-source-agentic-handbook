{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/open-agentic-handbook/update-plan.schema.json",
  "title": "Handbook update plan",
  "type": "object",
  "required": [
    "format",
    "id",
    "project_id",
    "status",
    "created_at",
    "source",
    "target",
    "changes",
    "validation",
    "approval_required",
    "digest"
  ],
  "properties": {
    "format": { "const": "open-agentic-handbook/update-plan@1" },
    "id": { "type": "string" },
    "project_id": { "type": "string" },
    "status": { "enum": ["current", "changes-required"] },
    "created_at": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "required": ["release", "manifest_digest", "selection_digest"]
    },
    "target": {
      "type": "object",
      "required": ["release", "manifest_digest", "selection_digest"]
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "id", "action", "from", "to"]
      }
    },
    "validation": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "approval_required": { "type": "boolean" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "additionalProperties": false
}
