{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/open-agentic-handbook/task-envelope.schema.json",
  "title": "Task envelope",
  "type": "object",
  "required": ["task", "scope", "data", "authority", "budgets", "validation", "human_approval", "termination"],
  "properties": {
    "task": {
      "type": "object",
      "required": ["id", "revision", "objective", "completion_criteria"],
      "properties": {
        "id": { "type": "string" },
        "revision": { "type": "integer", "minimum": 1 },
        "objective": { "type": "string", "minLength": 1 },
        "completion_criteria": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "scope": { "type": "object", "required": ["included", "excluded"] },
    "data": { "type": "object", "required": ["classification", "approved_sources", "retention"] },
    "authority": { "type": "object", "required": ["profile", "allowed_tools", "allowed_actions", "external_side_effects"] },
    "budgets": { "type": "object" },
    "validation": { "type": "object" },
    "human_approval": { "type": "object" },
    "termination": { "type": "object", "required": ["stop_when"] }
  },
  "additionalProperties": true
}
