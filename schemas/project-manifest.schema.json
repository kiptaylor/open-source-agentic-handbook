{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/open-agentic-handbook/project-manifest.schema.json",
  "title": "Downstream project manifest",
  "type": "object",
  "required": ["format", "project", "release", "selection", "boundaries", "output"],
  "properties": {
    "format": { "const": "open-agentic-handbook/project-manifest@1" },
    "project": {
      "type": "object",
      "required": ["id", "description"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
        "description": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "release": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "selection": {
      "type": "object",
      "required": ["agents", "skills", "guides"],
      "properties": {
        "agents": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "skills": {
          "type": "object",
          "required": ["core", "optional", "project"],
          "properties": {
            "core": { "const": "agent-required" },
            "optional": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string" }
            },
            "project": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "version", "path", "summary"],
                "properties": {
                  "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
                  "version": {
                    "type": "string",
                    "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
                  },
                  "path": { "type": "string", "minLength": 1 },
                  "summary": { "type": "string", "minLength": 1 }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "guides": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "boundaries": {
      "type": "object",
      "required": ["data", "permissions", "external_side_effects", "context"],
      "properties": {
        "data": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "permissions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "external_side_effects": { "type": "string", "minLength": 1 },
        "context": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "required": ["directory", "mode"],
      "properties": {
        "directory": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["prompt", "bundle"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
