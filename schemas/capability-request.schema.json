{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/open-agentic-handbook/capability-request.schema.json",
  "title": "Capability request",
  "type": "object",
  "required": ["format", "request"],
  "properties": {
    "format": { "const": "open-agentic-handbook/capability-request@1" },
    "request": {
      "type": "object",
      "required": [
        "id",
        "project_id",
        "kind",
        "title",
        "outcome",
        "scope",
        "data_boundary",
        "maximum_authority",
        "validation",
        "transport",
        "status"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
        "project_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
        "kind": {
          "enum": ["agent", "skill", "guide", "feature", "integration", "policy"]
        },
        "title": { "type": "string", "minLength": 1 },
        "outcome": { "type": "string", "minLength": 1 },
        "scope": {
          "type": "object",
          "required": ["included", "excluded"],
          "properties": {
            "included": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string" }
            },
            "excluded": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "additionalProperties": false
        },
        "data_boundary": { "type": "string", "minLength": 1 },
        "maximum_authority": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "validation": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "transport": {
          "type": "object",
          "required": ["kind", "destination"],
          "properties": {
            "kind": { "type": "string", "minLength": 1 },
            "destination": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": true
        },
        "status": { "const": "proposed" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
