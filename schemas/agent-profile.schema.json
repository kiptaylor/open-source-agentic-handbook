{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/open-agentic-handbook/agent-profile.schema.json",
  "title": "Agent profile",
  "type": "object",
  "required": ["profile", "skills", "authority", "context", "budgets", "escalation"],
  "properties": {
    "profile": {
      "type": "object",
      "required": ["id", "version", "class", "role"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
        "version": { "type": "string" },
        "class": { "enum": ["worker", "control-plane"] },
        "role": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "skills": { "type": "object" },
    "authority": {
      "type": "object",
      "required": ["allowed_actions", "prohibited_actions"],
      "properties": {
        "allowed_actions": { "type": "array", "items": { "type": "string" } },
        "prohibited_actions": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "context": { "type": "object" },
    "budgets": { "type": "object" },
    "escalation": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
